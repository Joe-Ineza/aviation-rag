# CMU AI Gateway
CMU_AI_GATEWAY_API_KEY=sk-...
CMU_AI_GATEWAY_BASE_URL=https://ai-gateway.andrew.cmu.edu/v1

# Models exposed by the gateway (Bedrock-style IDs)
GEN_MODEL=us.anthropic.claude-sonnet-4-6
JUDGE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Embeddings (local, no API)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Retrieval defaults
TOP_K_SEMANTIC=20
TOP_K_LEXICAL=20
TOP_K_FINAL=8
RRF_K=60

# Agent loop
MAX_REACT_STEPS=4
