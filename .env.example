# Gemini API (OpenAI-compatible endpoint)
# Get a free key at: https://aistudio.google.com/app/apikey
CMU_AI_GATEWAY_API_KEY=
CMU_AI_GATEWAY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Models
GEN_MODEL=gemini-pro-latest
JUDGE_MODEL=gemini-flash-latest

# Embeddings (local, no API)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Retrieval defaults
TOP_K_SEMANTIC=20
TOP_K_LEXICAL=20
TOP_K_FINAL=8
RRF_K=60

# Agent loop
MAX_REACT_STEPS=4

# Output token budgets (increase if responses are truncated)
MAX_TOKENS_JUDGE=800
MAX_TOKENS_GENERATOR=4096

# LLM retry on rate-limit / server error
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
